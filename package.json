{
  "name": "workflow-plugin",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "description": "Agent plugin for Workflow (workflow.games) — 技能包与契约测试",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:all": "npm test && npm run test:contract",
    "lint:plugin": "node plugin/tools/plugin-lint.mjs",
    "fingerprint": "node plugin/tools/fingerprint.mjs generate --rules plugin/rules --out plugin/rules/.fingerprint.json"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spec-lint": "plugin/bin/spec-lint.mjs"
  }
}
